  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <OutputType>Library</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <VtolVrDirectory Condition="'$(VtolVrDirectory)' == ''">C:\Program Files (x86)\Steam\steamapps\common\VTOL VR</VtolVrDirectory>
    <VtolVrManagedDirectory>$(VtolVrDirectory)\VTOLVR_Data\Managed</VtolVrManagedDirectory>
    <ModLoaderManagedDirectory Condition="Exists('$(VtolVrDirectory)\Managed\ModLoader.Framework.dll')">$(VtolVrDirectory)\Managed</ModLoaderManagedDirectory>
    <ModLoaderManagedDirectory Condition="'$(ModLoaderManagedDirectory)' == ''">$(VtolVrDirectory)\@Mod Loader\Managed</ModLoaderManagedDirectory>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="0Harmony">
      <HintPath>$(ModLoaderManagedDirectory)\0Harmony.dll</HintPath>
    </Reference>
    <Reference Include="Assembly-CSharp" Publicize="true">
      <HintPath>$(VtolVrManagedDirectory)\Assembly-CSharp.dll</HintPath>
    </Reference>
    <Reference Include="Mod Loader" Publicize="true">
      <HintPath>$(ModLoaderManagedDirectory)\Mod Loader.dll</HintPath>
    </Reference>
    <Reference Include="ModLoader.Framework" Publicize="true">
      <HintPath>$(ModLoaderManagedDirectory)\ModLoader.Framework.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine, Version=0.0.0.0, Culture=neutral, processorArchitecture=MSIL">
      <SpecificVersion>False</SpecificVersion>
      <HintPath>..\Dependencies\UnityEngine.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.AnimationModule">
      <HintPath>..\Dependencies\UnityEngine.AnimationModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.AssetBundleModule">
      <HintPath>..\Dependencies\UnityEngine.AssetBundleModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.AudioModule">
      <HintPath>$(VtolVrManagedDirectory)\UnityEngine.AudioModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>..\Dependencies\UnityEngine.CoreModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(VtolVrManagedDirectory)\UnityEngine.PhysicsModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>..\Dependencies\UnityEngine.UI.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(VtolVrManagedDirectory)\UnityEngine.TextRenderingModule.dll</HintPath>
    </Reference>
    <Reference Include="VTOLAPI">
      <HintPath>C:\Program Files (x86)\Steam\steamapps\workshop\content\3018410\3265689427\VTOLAPI.dll</HintPath>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Danku.BepInEx.AssemblyPublicizer.MSBuild" Version="0.4.5">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Lib.Harmony" Version="2.4.2" />
    <PackageReference Include="Microsoft.CSharp" Version="4.7.0" />
    <PackageReference Include="System.Data.DataSetExtensions" Version="4.5.0" />
  </ItemGroup>
	<Target Name="PostBuild" AfterTargets="PostBuildEvent">
		<Exec Command="xcopy &quot;$(TargetPath)&quot; &quot;C:\Program Files (x86)\Steam\steamapps\common\VTOL VR\@Mod Loader\Mods\VTOLVRSupercarrier\&quot; /i /y" />
	</Target>
</Project>
